datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  projects     Project[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Project {
  id          String        @id @default(cuid())
  ownerId     String
  name        String
  description String?
  userStories Int           @default(0)
  testStatus  ProjectStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner   User        @relation(fields: [ownerId], references: [id])
  stories UserStory[]

  @@index([ownerId])
}

enum ProjectStatus {
  PASSING
  FAILING
  PENDING
}

model UserStory {
  id          String      @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      StoryStatus @default(TODO)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project        Project          @relation(fields: [projectId], references: [id])
  generations    TestGeneration[]
  requiredFields RequiredField[]
}

enum StoryStatus {
  TODO
  IN_PROGRESS
  DONE
}

/**
 * -------------------- QA Entities --------------------
 */

enum RunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERRORED
}

model TestGeneration {
  id            String   @id @default(cuid())
  storyId       String
  url           String
  model         String?
  testCode      String
  pageStructure Json?
  testData      Json?
  createdAt     DateTime @default(now())

  story          UserStory       @relation(fields: [storyId], references: [id])
  runs           TestRun[]
  requiredFields RequiredField[]

  @@index([storyId])
}

model RequiredField {
  id           String   @id @default(cuid())
  storyId      String
  generationId String?
  key          String
  name         String
  description  String
  type         String
  required     Boolean
  placeholder  String?
  options      Json?
  createdAt    DateTime @default(now())

  story      UserStory       @relation(fields: [storyId], references: [id])
  generation TestGeneration? @relation(fields: [generationId], references: [id])

  @@unique([storyId, key]) // lets us upsert by (storyId, key)
  @@index([storyId])
  @@index([generationId])
}

model TestRun {
  id             String    @id @default(cuid())
  generationId   String
  status         RunStatus @default(RUNNING)
  passed         Boolean?
  testFilePath   String?
  output         String?
  errorOutput    String?
  executionError Boolean   @default(false)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  artifacts      Json?

  generation TestGeneration @relation(fields: [generationId], references: [id])

  @@index([generationId])
}
